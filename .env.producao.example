# =====================================================================
# StoqueOnline v2 - Configuração de PRODUÇÃO (Hostinger)
# =====================================================================
#
# COMO USAR:
#  1. Copie este arquivo para ".env.producao" e preencha os dados do
#     banco criado na Hostinger.
#  2. Rode localmente:  php database/enviar_para_hostinger.php --testar
#  3. Enviando os arquivos para o servidor, renomeie ".env.producao"
#     para ".env" lá dentro.
#
# Este arquivo NUNCA deve ficar acessível pela web (o .htaccess já
# bloqueia, mas confira depois de publicar).

# ---------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------
APP_NAME="StoqueOnline"
APP_ENV=production

# Em produção precisa ser false: com true o visitante vê erros internos
APP_DEBUG=false

# Endereço público do site, SEM barra no final.
# Troque para https:// assim que o certificado SSL estiver ativo.
APP_URL="http://stoque.lfdev.tech"

APP_TIMEZONE="America/Sao_Paulo"

# Só marque true se usar Cloudflare ou proxy na frente do site
TRUST_PROXY=false

# ---------------------------------------------------------------------
# Banco de dados (dados do hPanel -> Bancos de Dados MySQL)
# ---------------------------------------------------------------------
# DB_HOST: use "localhost" quando o site roda no mesmo servidor.
#          Para enviar os dados da sua máquina, use o host remoto que a
#          Hostinger informa (algo como srv1234.hstgr.io) e libere o seu
#          IP em "MySQL Remoto".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------
# E-mail (SMTP autenticado)
# ---------------------------------------------------------------------
# Obrigatório: sem isto ninguém confirma cadastro nem recupera senha.
#
# REGRA QUE QUEBRA NA CALADA:
#   MAIL_FROM_ADDRESS tem de ser a MESMA caixa de MAIL_USER.
#   Colocar outro endereço ali faz o provedor do destinatário checar o SPF
#   do domínio do remetente e não encontrar este servidor na lista — a
#   mensagem cai em spam ou volta. O Gmail disfarça o problema reescrevendo
#   o remetente sozinho (deixa o rastro X-Google-Original-From no e-mail);
#   o SMTP da Hostinger e a maioria dos outros não reescrevem.
#
# MAIL_CONTACT_ADDRESS é outra coisa: é o DESTINO do formulário de contato.
# Esse sim pode ser qualquer caixa, inclusive de outro provedor.
#
# Gmail/Google Workspace exigem "Senha de app", não a senha da conta:
#   myaccount.google.com -> Segurança -> Verificação em duas etapas -> Senhas de app
# Se o e-mail for da própria Hostinger:
#   MAIL_HOST=smtp.hostinger.com  /  MAIL_PORT=587  /  MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.hostinger.com  /  MAIL_PORT=587  /  MAIL_ENCRYPTION=tls
# Se for Gmail, use uma Senha de App (não a senha da conta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=sua_conta@gmail.com
MAIL_PASS=
MAIL_FROM_ADDRESS=sua_conta@gmail.com
MAIL_FROM_NAME="StoqueOnline"

# Caixa que recebe as mensagens do formulário de contato
MAIL_CONTACT_ADDRESS=daniel_amorimtj@hotmail.com

# ---------------------------------------------------------------------
# PicPay
# ---------------------------------------------------------------------
# Gere tokens NOVOS no painel do lojista: os antigos circularam em arquivo.
# Sem PICPAY_SELLER_TOKEN o webhook fica desativado de propósito.
PICPAY_TOKEN=
PICPAY_SELLER_TOKEN=
PICPAY_CALLBACK_URL="http://stoque.lfdev.tech/pagamento/callback"
PICPAY_RETURN_URL="http://stoque.lfdev.tech/pagamento/sucesso"

# ---------------------------------------------------------------------
# Atualização do banco de dados
# ---------------------------------------------------------------------
# Chave da página que aplica as migrações. Sempre que subir arquivos
# novos, abra: https://SEUDOMINIO/atualizar.php?token=A_CHAVE
# Pode manter esta linha em definitivo: a página só executa com a chave.
UPDATE_TOKEN=9a0b35c5a8529f950fe5f6e45e7e0845

# ---------------------------------------------------------------------
# Diagnóstico pós-publicação (temporário)
# ---------------------------------------------------------------------
# Com esta chave preenchida, abra no navegador:
#   http://stoque.lfdev.tech/diagnostico.php?token=A_CHAVE
# Ela mostra se PHP, banco, e-mail e permissões estão corretos.
# APAGUE a linha (e o arquivo public/diagnostico.php) quando terminar.
DIAGNOSTIC_TOKEN=TROQUE_POR_UMA_CHAVE_LONGA
